{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.googleapis.com/*"
        }
      ]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme"
  ]
}
